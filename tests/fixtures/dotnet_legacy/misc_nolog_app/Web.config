<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.web>
    <compilation debug="false" targetFramework="4.7.2" />
  </system.web>
  <system.serviceModel>
    <client>
      <endpoint name="Pay" address="http://pay.example.net/svc" binding="basicHttpBinding" contract="IPay" />
      <endpoint name="Ledger" address="https://ledger.example.net/svc" binding="basicHttpBinding" contract="ILedger" />
      <endpoint name="Dev" address="http://localhost:8080/svc" binding="basicHttpBinding" contract="IDev" />
    </client>
  </system.serviceModel>
</configuration>
