<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <authorization>
      <allow users="*" />
    </authorization>
    <httpHandlers>
      <add path="Reports/elmah.axd" verb="POST,GET,HEAD" type="Elmah.ErrorLogPageFactory, Elmah" />
    </httpHandlers>
  </system.web>
  <connectionStrings>
    <add name="Main" connectionString="Server=dev;Database=App;User Id=sa;Password=Passw0rd1" providerName="System.Data.SqlClient" />
    <add name="Audit" connectionString="Server=dev;Database=Audit;Integrated Security=SSPI" />
    <add name="Reporting" connectionString="Server=dev;Database=Rpt;User Id=rpt;Pwd=Summer2020!;" />
    <add name="Templated" connectionString="Server=dev;Database=T;User Id=app;Password=$(DbPassword)" />
  </connectionStrings>
  <location path="Reports">
    <system.web>
      <authorization>
        <deny users="?" />
      </authorization>
    </system.web>
  </location>
</configuration>
