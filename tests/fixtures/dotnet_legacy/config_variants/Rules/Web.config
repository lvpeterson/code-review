<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <add key="PaymentApiKey" value="abcd1234efgh" />
    <add key="MailPassword" value="#{MailPassword}" />
    <add key="Theme" value="dark" />
  </appSettings>
  <elmah>
    <security allowRemoteAccess="yes" />
  </elmah>
  <system.web>
    <compilation targetFramework="4.8" />
    <customErrors mode="RemoteOnly" />
    <trace enabled="true" localOnly="false" />
    <httpRuntime requestValidationMode="2.0" maxRequestLength="204800" />
    <pages validateRequest="false" enableViewStateMac="false" />
    <authentication mode="Forms">
      <forms loginUrl="~/Login" requireSSL="false" timeout="120" cookieless="UseUri" />
    </authentication>
    <sessionState cookieless="true" />
    <machineKey validationKey="0123456789ABCDEF" decryptionKey="FEDCBA9876543210" />
    <membership>
      <providers>
        <add name="Clr" type="System.Web.Security.SqlMembershipProvider" passwordFormat="Clear" />
        <add name="Enc" type="System.Web.Security.SqlMembershipProvider" passwordFormat="Encrypted" />
        <add name="Hsh" type="System.Web.Security.SqlMembershipProvider" passwordFormat="Hashed" />
      </providers>
    </membership>
  </system.web>
  <system.webServer>
    <httpProtocol>
      <customHeaders>
        <add name="Access-Control-Allow-Origin" value="*" />
        <add name="X-Frame-Options" value="DENY" />
      </customHeaders>
    </httpProtocol>
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="209715200" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
