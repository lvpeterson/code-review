<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.web>
    <compilation targetFramework="4.7.2" />
  </system.web>
  <system.serviceModel>
    <services>
      <!-- Config-rule fixtures: service types are synthetic, only the configuration is scanned. -->
      <service name="Cfg.OpenSvc" behaviorConfiguration="debugOn">
        <endpoint address="plain" binding="basicHttpBinding" contract="Cfg.IOpen" />
        <endpoint address="shared" binding="basicHttpBinding" bindingConfiguration="shared" contract="Cfg.IOpen" />
        <endpoint address="nosec" binding="wsHttpBinding" bindingConfiguration="secNone" contract="Cfg.IOpen" />
        <endpoint address="anon" binding="wsHttpBinding" bindingConfiguration="msgAnon" contract="Cfg.IOpen" />
        <endpoint address="big" binding="basicHttpBinding" bindingConfiguration="bigMsg" contract="Cfg.IOpen" />
        <endpoint address="mex" binding="mexHttpBinding" contract="IMetadataExchange" />
      </service>
      <service name="Cfg.SafeSvc" behaviorConfiguration="safeBeh">
        <endpoint address="shared" binding="wsHttpBinding" bindingConfiguration="shared" contract="Cfg.ISafe" />
        <endpoint address="https" binding="basicHttpBinding" bindingConfiguration="httpsOnly" contract="Cfg.ISafe" />
        <endpoint address="https://example.test/anon" binding="wsHttpBinding" bindingConfiguration="transportAnon" contract="Cfg.ISafe" />
      </service>
      <service name="Cfg.LocalSvc">
        <endpoint address="http://localhost:8733/local" binding="basicHttpBinding" contract="Cfg.ILocal" />
        <endpoint address="net.pipe://localhost/local" binding="basicHttpBinding" bindingConfiguration="secNone" contract="Cfg.ILocal" />
      </service>
      <service name="Cfg.ExtraSvc" behaviorConfiguration="safeBeh">
        <endpoint address="localhost/x" binding="basicHttpBinding" bindingConfiguration="relLocal" contract="Cfg.IExtra" />
        <endpoint address="cred" binding="basicHttpBinding" bindingConfiguration="credOnly" contract="Cfg.IExtra" />
        <endpoint address="shared2" binding="basicHttpBinding" bindingConfiguration="shared" contract="Cfg.IExtra" />
        <endpoint address="cust" binding="customBinding" bindingConfiguration="customBig" contract="Cfg.IExtra" />
      </service>
    </services>
    <bindings>
      <customBinding>
        <binding name="customBig">
          <binaryMessageEncoding><readerQuotas maxArrayLength="20971520" /></binaryMessageEncoding>
          <httpTransport maxReceivedMessageSize="104857600" />
        </binding>
      </customBinding>
      <basicHttpBinding>
        <binding name="relLocal">
          <security mode="None" />
        </binding>
        <binding name="credOnly"><security mode="TransportCredentialOnly"><transport clientCredentialType="Basic" /></security></binding>
        <binding name="shared"><security mode="None" /></binding>
        <binding name="httpsOnly"><security mode="Transport"><transport clientCredentialType="Basic" /></security></binding>
        <binding name="bigMsg" maxReceivedMessageSize="104857600"><readerQuotas maxStringContentLength="20971520" /></binding>
      </basicHttpBinding>
      <wsHttpBinding>
        <binding name="shared" />
        <binding name="secNone"><security mode="None" /></binding>
        <binding name="msgAnon"><security mode="Message"><message clientCredentialType="None" /></security></binding>
        <binding name="transportAnon"><security mode="Transport"><transport clientCredentialType="None" /></security></binding>
      </wsHttpBinding>
    </bindings>
    <behaviors>
      <serviceBehaviors>
        <behavior name="debugOn">
          <serviceDebug includeExceptionDetailInFaults="true" />
          <serviceMetadata httpGetEnabled="true" />
        </behavior>
        <behavior name="safeBeh">
          <serviceDebug includeExceptionDetailInFaults="false" />
          <serviceMetadata httpGetEnabled="false" httpsGetEnabled="false" />
          <serviceThrottling maxConcurrentCalls="32" />
        </behavior>
      </serviceBehaviors>
    </behaviors>
    <serviceHostingEnvironment>
      <serviceActivations>
        <add relativeAddress="Billing.svc" service="WcfSvc.BillingService" />
      </serviceActivations>
    </serviceHostingEnvironment>
  </system.serviceModel>
</configuration>
